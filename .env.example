# Copy to .env for local development. Values here are safe to expose in the browser.
PUBLIC_SITE_URL=http://localhost:4321
PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Supabase "publishable" (anon) key — safe in the browser; RLS protects the data.
PUBLIC_SUPABASE_ANON_KEY=
# Cloudflare Turnstile site key (public). Use 1x00000000000000000000AA for local testing.
PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# ── Server-side secrets: set these ONLY in Supabase (Edge Function secrets) ──
# TURNSTILE_SECRET_KEY=           # Cloudflare Turnstile secret
# IP_HASH_SALT=                   # random 32+ chars, used to hash visitor IPs for rate limiting
# ALLOWED_ORIGINS=https://travelinhimachal.in,https://www.travelinhimachal.in
