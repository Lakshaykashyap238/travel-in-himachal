---
import Base from '@/layouts/Base.astro';
import PageHeader from '@/components/PageHeader.astro';
import ReviewForm from '@/components/ReviewForm';
---
<Base title="Write a review" description="Travelled with us? Tell other travellers about your trip.">
  <PageHeader title="Write a review" intro="Travelled with us? Tell other travellers how your trip went. You'll need your booking reference and the phone number you booked with." />
  <div class="mx-auto max-w-3xl px-4 py-10">
    <ReviewForm client:load />
  </div>
</Base>
