---
import CatalogueImage from '@/components/CatalogueImage.astro';
import Base from '@/layouts/Base.astro';
import HeroSlider from '@/components/HeroSlider.astro';
import TourCard from '@/components/TourCard.astro';
import Icon from '@/components/Icon.astro';
import { formatInr, getCatalogue, resolveImage } from '@/lib/catalogue';

const { settings, tours, destinations, vehicles, reviews } = await getCatalogue();
const shownReviews = reviews.slice(0, 6);
const avgRating = reviews.length ? (reviews.reduce((a, r) => a + r.rating, 0) / reviews.length).toFixed(1) : null;

const quickLinks = [
  { href: '/tours', icon: 'mountain', label: 'Tours', note: `${tours.length} tours` },
  { href: '/destinations', icon: 'pin', label: 'Destinations', note: `${destinations.length} places` },
  { href: '/fleet', icon: 'car', label: 'Cabs', note: `${vehicles.length} cars` },
  { href: '/about', icon: 'info', label: 'About us', note: 'Who we are' },
  { href: '/contact', icon: 'phone', label: 'Contact', note: 'Call or WhatsApp' },
] as const;

const promises = [
  { icon: 'car', text: 'Private cab with every tour' },
  { icon: 'wallet', text: 'Fare agreed before you travel' },
  { icon: 'shield', text: 'Verified, experienced drivers' },
  { icon: 'headset', text: 'Call us before, during or after your trip' },
] as const;

const reasons = [
  { icon: 'click', title: 'Easy booking', text: 'Book a tour or cab online in a few minutes, and track your booking status on your own link.' },
  { icon: 'wallet', title: 'Clear pricing', text: 'The fare is agreed with you before your trip is confirmed. No surprises on the road.' },
  { icon: 'mountain', title: 'Local knowledge', text: 'Routes, stops and timings planned by people who drive these mountain roads.' },
  { icon: 'headset', title: 'Help when you need it', text: 'Call us before, during or after your trip.' },
] as const;

const stats = [
  settings.stat_travellers ? { value: `${settings.stat_travellers.toLocaleString('en-IN')}+`, label: 'Happy travellers' } : null,
  destinations.length ? { value: `${destinations.length}`, label: 'Destinations' } : null,
  settings.stat_years ? { value: `${settings.stat_years}+`, label: 'Years of experience' } : null,
].filter(Boolean) as { value: string; label: string }[];
---
<Base
  title={settings.business_name}
  description={`${settings.tagline ?? 'Tours and cabs across Himachal Pradesh'}. Book Shimla, Manali, Spiti, Dharamshala, Kasol and more — ${tours.length} tour packages and private cabs.`}
>
  <HeroSlider />

  <!-- Every section, one tap from the home page -->
  <nav class="border-b border-black/10 bg-white" aria-label="Explore">
    <ul class="mx-auto flex max-w-7xl snap-x gap-3 overflow-x-auto px-4 py-4 [scrollbar-width:none] lg:grid lg:grid-cols-5 lg:overflow-visible">
      {quickLinks.map((q) => (
        <li class="w-[42%] shrink-0 snap-start sm:w-[30%] lg:w-auto">
          <a href={q.href} class="flex h-full items-center gap-3 rounded-xl border border-black/10 p-3 hover:border-brand hover:bg-mist">
            <span class="grid h-11 w-11 shrink-0 place-items-center rounded-lg bg-brand text-white"><Icon name={q.icon} class="h-6 w-6" /></span>
            <span class="min-w-0">
              <span class="block font-semibold leading-tight text-ink">{q.label}</span>
              <span class="block truncate text-sm text-stone">{q.note}</span>
            </span>
          </a>
        </li>
      ))}
    </ul>
  </nav>

  <!-- What every trip includes: the promises a traveller cares about first -->
  <section class="bg-night text-white" aria-label="Included with every trip">
    <ul class="mx-auto grid max-w-7xl gap-x-8 gap-y-3 px-4 py-5 text-[15px] sm:grid-cols-2 lg:grid-cols-4">
      {promises.map((p) => (
        <li class="flex items-center gap-3"><Icon name={p.icon} class="h-5 w-5 shrink-0 text-accent" />{p.text}</li>
      ))}
    </ul>
  </section>

  <section class="mx-auto max-w-7xl px-4 py-16 sm:py-20" aria-labelledby="tours-heading">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <div class="max-w-2xl">
        <h2 id="tours-heading" class="display text-4xl uppercase sm:text-6xl">Tour packages</h2>
        <p class="mt-3 text-lg text-stone">Each tour comes with a private cab and a driver who knows the hill roads.</p>
      </div>
      <a href="/tours" class="font-semibold text-brand underline-offset-4 hover:underline">See all {tours.length} tours</a>
    </div>
    <div class="mt-10 grid gap-x-6 gap-y-10 sm:grid-cols-2 lg:grid-cols-4">
      {tours.slice(0, 8).map((t, i) => <TourCard tour={t} eager={i < 4} />)}
    </div>
  </section>

  <section class="bg-mist py-16 sm:py-20" aria-labelledby="why-heading">
    <div class="mx-auto grid max-w-7xl gap-12 px-4 lg:grid-cols-[1fr_1.2fr] lg:items-start">
      <div>
        <h2 id="why-heading" class="display text-4xl uppercase sm:text-6xl">Travel with people who drive these roads every day</h2>
        <p class="mt-5 max-w-xl text-lg text-stone">We make your journey comfortable, safe and memorable, from an easy booking to a driver who knows the mountains.</p>
        <a href="/about" class="mt-4 inline-block font-semibold text-brand underline-offset-4 hover:underline">More about us</a>
        {stats.length > 0 && (
          <dl class="mt-10 flex flex-wrap gap-x-12 gap-y-6">
            {stats.map((s) => (
              <div class="border-l-[3px] border-accent pl-4">
                <dd class="display text-5xl text-ink">{s.value}</dd>
                <dt class="mt-1 text-stone">{s.label}</dt>
              </div>
            ))}
          </dl>
        )}
      </div>
      <ul class="grid gap-x-10 gap-y-8 sm:grid-cols-2">
        {reasons.map((r) => (
          <li>
            <Icon name={r.icon} class="h-7 w-7 text-brand" />
            <h3 class="mt-3 text-2xl font-bold">{r.title}</h3>
            <p class="mt-1 text-stone">{r.text}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>


  {(shownReviews.length > 0 || settings.google_review_url) && (
    <section class="py-16 sm:py-20" aria-labelledby="reviews-heading">
      <div class="mx-auto max-w-7xl px-4">
        <div class="flex flex-wrap items-end justify-between gap-4">
          <div>
            <h2 id="reviews-heading" class="display text-4xl uppercase sm:text-6xl">What travellers say</h2>
            {avgRating && <p class="mt-3 text-lg text-stone"><span class="font-semibold text-ink">{avgRating} out of 5</span> from {reviews.length} {reviews.length === 1 ? 'review' : 'reviews'}</p>}
          </div>
          {settings.google_review_url && <a href={settings.google_review_url} target="_blank" rel="noopener" class="font-semibold text-brand underline-offset-4 hover:underline">Read all reviews on Google</a>}
        </div>
        {shownReviews.length > 0 ? (
          <ul class="mt-10 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
            {shownReviews.map((r) => (
              <li class="flex flex-col rounded-xl bg-mist p-6">
                <p class="text-xl tracking-wider text-accent" aria-label={`${r.rating} out of 5 stars`}>{'★'.repeat(r.rating)}<span class="text-black/15">{'★'.repeat(5 - r.rating)}</span></p>
                <blockquote class="mt-3 flex-1 text-ink">“{r.body}”</blockquote>
                <p class="mt-5 font-semibold">{r.name}{r.place && <span class="font-normal text-stone">, {r.place}</span>}</p>
                <p class="text-sm text-stone">{[r.trip, `on ${r.source}`].filter(Boolean).join(', ')}</p>
              </li>
            ))}
          </ul>
        ) : (
          <p class="mt-6 max-w-xl text-lg text-stone">See what our travellers have written about their trips with us.</p>
        )}
      </div>
    </section>
  )}

  <section class="mx-auto max-w-7xl px-4 py-16 sm:py-20" aria-labelledby="dest-heading">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <h2 id="dest-heading" class="display text-4xl uppercase sm:text-6xl">Places we cover</h2>
      <a href="/destinations" class="font-semibold text-brand underline-offset-4 hover:underline">All destinations</a>
    </div>
    <div class="mt-10 grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-6">
      {destinations.slice(0, 6).map((d) => {
        const img = resolveImage(d.image_path);
        return (
          <a href={`/destinations/${d.slug}`} class="group relative aspect-[3/4] overflow-hidden rounded-xl bg-night">
            {img && <CatalogueImage src={img} alt="" widths={[240, 400]} sizes="(min-width: 1024px) 16vw, 50vw" class="h-full w-full object-cover transition duration-700 group-hover:scale-[1.03] motion-reduce:transition-none" />}
            <span class="absolute inset-0 bg-gradient-to-t from-night/85 to-transparent"></span>
            <span class="display absolute bottom-3 left-3 text-2xl uppercase text-white">{d.name}</span>
          </a>
        );
      })}
    </div>
  </section>

  {vehicles.length > 0 && (
    <section class="bg-night py-16 text-white sm:py-20" aria-labelledby="fleet-heading">
      <div class="mx-auto max-w-7xl px-4">
        <h2 id="fleet-heading" class="display text-4xl uppercase sm:text-6xl">Private cabs</h2>
        <p class="mt-3 max-w-2xl text-lg text-white/80">Clean, well-kept cars with verified drivers, for one-way trips, round trips, airport pickups and local sightseeing.</p>
        <div class="mt-10 grid gap-6 md:grid-cols-2">
          {vehicles.map((v) => {
            const img = resolveImage(v.image_path);
            return (
              <div class="flex items-center gap-5 rounded-xl bg-white/[0.06] p-5 ring-1 ring-white/10">
                {img && <CatalogueImage src={img} alt={v.name} widths={[240, 400]} sizes="200px" class="w-40 shrink-0 object-contain sm:w-52" />}
                <div>
                  <h3 class="text-3xl font-bold">{v.name}</h3>
                  <p class="mt-1 text-white/75">{v.seats} seats, {v.luggage} bags, AC</p>
                  <p class="mt-2">{v.price_per_day != null ? <><span class="text-xl font-semibold">{formatInr(v.price_per_day)}</span><span class="text-white/75"> per day</span></> : <span class="text-white/75">Price on request</span>}</p>
                  <a href={`/book?type=cab&car=${v.slug}`} class="mt-4 inline-block rounded-md bg-accent px-5 py-2 font-semibold text-ink hover:bg-white">Book this car</a>
                </div>
              </div>
            );
          })}
        </div>
      </div>
    </section>
  )}

  <section class="mx-auto max-w-7xl px-4 py-16 sm:py-24">
    <div class="grid gap-8 lg:grid-cols-[1.4fr_1fr] lg:items-end">
      <div>
        <h2 class="display text-5xl uppercase sm:text-7xl">Ready to plan your trip?</h2>
        <p class="mt-4 max-w-xl text-lg text-stone">Send a booking request in two minutes. We'll confirm the fare and call you back. No payment needed now.</p>
      </div>
      <div class="flex flex-wrap gap-3 lg:justify-end">
        <a href="/book" class="rounded-md bg-brand px-7 py-3.5 text-lg font-semibold text-white hover:bg-brand-dark">Send a booking request</a>
        {settings.phone && <a href={`tel:${settings.phone}`} class="rounded-md border-2 border-ink px-7 py-3.5 text-lg font-semibold hover:bg-ink hover:text-white">Call us</a>}
      </div>
    </div>
  </section>
</Base>

