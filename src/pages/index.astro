---
import CatalogueImage from '@/components/CatalogueImage.astro';
import Base from '@/layouts/Base.astro';
import HeroSlider from '@/components/HeroSlider.astro';
import TourCard from '@/components/TourCard.astro';
import Icon from '@/components/Icon.astro';
import { formatInr, getCatalogue, resolveImage } from '@/lib/catalogue';

const { settings, tours, destinations, vehicles } = await getCatalogue();

const services = [
  'Customized tour packages', 'Airport pickup & drop', 'Honeymoon packages', 'Family tours',
  'Adventure trips', 'Hotel booking assistance', 'Experienced drivers', 'Safe & comfortable travel',
];

const reasons = [
  { icon: 'click', title: 'Easy booking', text: 'Book a tour or cab online in a few minutes, and track your booking status on your own link.' },
  { icon: 'wallet', title: 'Clear pricing', text: 'The fare is agreed with you before your trip is confirmed. No surprises on the road.' },
  { icon: 'mountain', title: 'Local knowledge', text: 'Routes, stops and timings planned by people who drive these mountain roads.' },
  { icon: 'headset', title: 'Help when you need it', text: 'Call us before, during or after your trip.' },
] as const;

const stats = [
  settings.stat_travellers ? { value: `${settings.stat_travellers.toLocaleString('en-IN')}+`, label: 'Happy travellers' } : null,
  destinations.length ? { value: `${destinations.length}`, label: 'Destinations' } : null,
  settings.stat_years ? { value: `${settings.stat_years}+`, label: 'Years of experience' } : null,
].filter(Boolean) as { value: string; label: string }[];
---
<Base
  title={settings.business_name}
  description={`${settings.tagline ?? 'Tours and cabs across Himachal Pradesh'}. Book Shimla, Manali, Spiti, Dharamshala, Kasol and more — ${tours.length} tour packages and private cabs.`}
>
  <HeroSlider />

  <!-- Services strip (the original site's gold-star marquee) -->
  <div class="overflow-hidden bg-[#252525] py-3 text-sm text-white" aria-label="Our services">
    <ul class="marquee flex w-max gap-12 whitespace-nowrap">
      {[...services, ...services].map((s, i) => (
        <li aria-hidden={i >= services.length ? 'true' : undefined} class="flex items-center gap-3"><span class="text-accent">★</span>{s}</li>
      ))}
    </ul>
  </div>

  <section class="mx-auto max-w-7xl px-4 py-16" aria-labelledby="tours-heading">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <div>
        <p class="text-sm font-bold uppercase tracking-widest text-accent">Tour packages</p>
        <h2 id="tours-heading" class="mt-1 text-3xl font-bold">Our tour packages</h2>
      </div>
      <a href="/tours" class="flex items-center gap-1 font-semibold text-brand hover:underline">All tours <Icon name="arrow" class="h-4 w-4" /></a>
    </div>
    <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {tours.slice(0, 8).map((t, i) => <TourCard tour={t} eager={i < 4} />)}
    </div>
  </section>

  <section class="bg-slate-50 py-16" aria-labelledby="why-heading">
    <div class="mx-auto grid max-w-7xl items-center gap-12 px-4 lg:grid-cols-2">
      <div>
        <p class="text-sm font-bold uppercase tracking-widest text-accent">Why choose us</p>
        <h2 id="why-heading" class="mt-2 text-3xl font-bold leading-tight sm:text-4xl">Your trusted travel partner in Himachal</h2>
        <p class="mt-4 max-w-xl text-slate-600">We make your journey comfortable, safe and memorable — from an easy booking to a driver who knows the mountains.</p>
        {stats.length > 0 && (
          <dl class="mt-8 flex flex-wrap gap-4">
            {stats.map((s) => (
              <div class="min-w-32 rounded-2xl bg-white p-5 shadow-sm ring-1 ring-black/5">
                <dt class="text-sm text-slate-500">{s.label}</dt>
                <dd class="text-3xl font-bold text-ink">{s.value}</dd>
              </div>
            ))}
          </dl>
        )}
      </div>
      <div class="grid gap-5 sm:grid-cols-2">
        {reasons.map((r) => (
          <div class="rounded-2xl bg-white p-6 shadow-sm ring-1 ring-black/5">
            <span class="inline-flex rounded-xl bg-brand/10 p-3 text-brand"><Icon name={r.icon} class="h-6 w-6" /></span>
            <h3 class="mt-4 text-lg font-semibold">{r.title}</h3>
            <p class="mt-2 text-sm text-slate-600">{r.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-4 py-16" aria-labelledby="dest-heading">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <div>
        <p class="text-sm font-bold uppercase tracking-widest text-accent">Destinations</p>
        <h2 id="dest-heading" class="mt-1 text-3xl font-bold">Places we cover</h2>
      </div>
      <a href="/destinations" class="flex items-center gap-1 font-semibold text-brand hover:underline">All destinations <Icon name="arrow" class="h-4 w-4" /></a>
    </div>
    <div class="mt-8 grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-6">
      {destinations.slice(0, 6).map((d) => {
        const img = resolveImage(d.image_path);
        return (
          <a href={`/destinations/${d.slug}`} class="group relative aspect-[3/4] overflow-hidden rounded-2xl bg-slate-200">
            {img && <CatalogueImage src={img} alt="" widths={[240, 400]} sizes="(min-width: 1024px) 16vw, 50vw" class="h-full w-full object-cover transition duration-700 group-hover:scale-105" />}
            <span class="absolute inset-0 bg-gradient-to-t from-black/70 to-transparent"></span>
            <span class="absolute bottom-3 left-3 text-lg font-semibold text-white">{d.name}</span>
          </a>
        );
      })}
    </div>
  </section>

  {vehicles.length > 0 && (
    <section class="bg-[rgb(3,89,164)] py-16 text-white" aria-labelledby="fleet-heading">
      <div class="mx-auto max-w-7xl px-4">
        <h2 id="fleet-heading" class="text-3xl font-bold">Private cabs for every journey</h2>
        <p class="mt-2 max-w-2xl text-white/85">Well-maintained cars with experienced, verified drivers. One-way, round trip, airport or local sightseeing.</p>
        <div class="mt-8 grid gap-6 md:grid-cols-2">
          {vehicles.map((v) => {
            const img = resolveImage(v.image_path);
            return (
              <div class="flex items-center gap-5 rounded-2xl bg-white p-5 text-ink">
                {img && <CatalogueImage src={img} alt={v.name} widths={[240, 400]} sizes="200px" class="w-40 shrink-0 object-contain sm:w-48" />}
                <div>
                  <h3 class="text-xl font-bold">{v.name}</h3>
                  <p class="mt-1 text-sm text-slate-600">{v.seats} seats · {v.luggage} bags · AC</p>
                  <p class="mt-2 text-sm">{v.price_per_day != null ? <><span class="text-lg font-bold">{formatInr(v.price_per_day)}</span> / day</> : 'Price on request'}</p>
                  <a href={`/book?type=cab&car=${v.slug}`} class="mt-3 inline-block rounded-full bg-ink px-4 py-2 text-sm font-semibold text-white hover:bg-black">Book this car</a>
                </div>
              </div>
            );
          })}
        </div>
      </div>
    </section>
  )}

  <section class="mx-auto max-w-4xl px-4 py-16 text-center">
    <h2 class="text-3xl font-bold">Ready to plan your trip?</h2>
    <p class="mt-3 text-slate-600">Send your booking request in two minutes. We'll confirm the fare and call you back.</p>
    <div class="mt-6 flex flex-wrap justify-center gap-3">
      <a href="/book" class="rounded-full bg-brand px-6 py-3 font-semibold text-white hover:bg-brand-dark">Book now</a>
      {settings.google_review_url && <a href={settings.google_review_url} target="_blank" rel="noopener" class="rounded-full border border-slate-300 px-6 py-3 font-semibold hover:bg-slate-50">Read our Google reviews</a>}
    </div>
  </section>
</Base>

<style>
  .marquee { animation: marquee 40s linear infinite; }
  @keyframes marquee { from { transform: translateX(0); } to { transform: translateX(-50%); } }
  @media (prefers-reduced-motion: reduce) { .marquee { animation: none; } }
</style>
