---
import Base from '@/layouts/Base.astro';
import RideBooking from '@/components/RideBooking.astro';
import { getCatalogue } from '@/lib/catalogue';
import { breadcrumbLd } from '@/lib/seo';

const { vehicles } = await getCatalogue();
const crumbs = [{ href: '/fleet', label: 'Cab booking' }];
---
<Base title="Cab booking in Himachal" description={`Book a private cab in Himachal Pradesh: ${vehicles.map((v) => v.name).join(', ')}. One-way, round trip, airport pickup and sightseeing.`} jsonLd={[breadcrumbLd(Astro.site, crumbs)]} bare>
  <RideBooking />
</Base>
