---
import Base from '@/layouts/Base.astro';
import PageHeader from '@/components/PageHeader.astro';
import BookingForm from '@/components/BookingForm';
import { durationLabel, getCatalogue } from '@/lib/catalogue';

const { tours, vehicles, settings } = await getCatalogue();
---
<Base title="Book a tour or cab" description="Send a booking request for a Himachal tour or a private cab. No payment needed — we confirm the fare with you.">
  <PageHeader eyebrow="Booking" title="Book a tour or cab" intro="Tell us about your trip. We'll review it and call you to confirm the fare — no payment now." crumbs={[{ href: '/book', label: 'Book' }]} />
  <div class="mx-auto max-w-3xl px-4 pb-16">
    <BookingForm
      client:load
      tours={tours.map((t) => ({ slug: t.slug, name: t.name, duration: durationLabel(t) }))}
      cars={vehicles.map((v) => ({ slug: v.slug, name: v.name, seats: v.seats }))}
      turnstileSiteKey={import.meta.env.PUBLIC_TURNSTILE_SITE_KEY ?? ''}
      phone={settings.phone}
    />
  </div>
</Base>
