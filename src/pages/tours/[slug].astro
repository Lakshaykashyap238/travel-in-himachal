---
import { getImage } from 'astro:assets';
import CatalogueImage from '@/components/CatalogueImage.astro';
import Base from '@/layouts/Base.astro';
import Icon from '@/components/Icon.astro';
import TourCard from '@/components/TourCard.astro';
import { durationLabel, formatInr, getCatalogue, resolveImage, type Tour } from '@/lib/catalogue';
import { breadcrumbLd } from '@/lib/seo';

export async function getStaticPaths() {
  const { tours } = await getCatalogue();
  return tours.map((tour) => ({ params: { slug: tour.slug }, props: { tour } }));
}

const { tour: t } = Astro.props as { tour: Tour };
const { tours, destinations, settings } = await getCatalogue();
const destination = destinations.find((d) => d.slug === t.destination_slug);
const img = resolveImage(t.image_path);
const og = img ? await getImage({ src: img, width: 1200, format: 'jpg', inferSize: typeof img === 'string' }) : undefined;
const related = tours.filter((x) => x.slug !== t.slug && x.destination_slug === t.destination_slug).concat(tours.filter((x) => x.slug !== t.slug)).filter((x, i, a) => a.indexOf(x) === i).slice(0, 4);

const crumbs = [{ href: '/tours', label: 'Tour packages' }, { href: `/tours/${t.slug}`, label: t.name }];
const description =
  t.summary ??
  `${t.name}: ${durationLabel(t)} with a private cab and driver${t.places.length ? `, covering ${t.places.slice(0, 4).join(', ')}` : ''}. ${t.starting_price != null ? `From ${formatInr(t.starting_price)} per traveller.` : 'Price on request.'}`;

const tripLd = {
  '@context': 'https://schema.org',
  '@type': 'TouristTrip',
  name: t.name,
  description,
  touristType: ['Family', 'Couples', 'Friends'],
  provider: { '@id': new URL('/#business', Astro.site).toString() },
  ...(og && { image: new URL(og.src, Astro.site).toString() }),
  ...(t.places.length && { itinerary: { '@type': 'ItemList', itemListElement: t.places.map((p, i) => ({ '@type': 'ListItem', position: i + 1, item: { '@type': 'TouristAttraction', name: p } })) } }),
  ...(t.starting_price != null && { offers: { '@type': 'Offer', price: t.starting_price, priceCurrency: 'INR', url: new URL(`/tours/${t.slug}`, Astro.site).toString(), availability: 'https://schema.org/InStock' } }),
};
---
<Base title={`${t.name} – ${durationLabel(t)}`} description={description} image={og?.src} jsonLd={[tripLd, breadcrumbLd(Astro.site, crumbs)]}>
  <article>
    <div class="relative h-[42vh] min-h-[300px] overflow-hidden bg-night">
      {img && <CatalogueImage src={img} alt={t.name} widths={[640, 1024, 1600]} sizes="100vw" loading="eager" fetchpriority="high" class="h-full w-full object-cover opacity-90" />}
      <div class="absolute inset-0 bg-gradient-to-t from-black/75 via-black/20 to-transparent"></div>
      <div class="absolute inset-x-0 bottom-0 mx-auto max-w-7xl px-4 pb-8 text-white">
        <nav aria-label="Breadcrumb" class="mb-3 text-sm text-white/80">
          <a href="/" class="hover:text-white">Home</a> / <a href="/tours" class="hover:text-white">Tour packages</a>
        </nav>
        <h1 class="text-3xl font-extrabold sm:text-5xl">{t.name}</h1>
        <p class="mt-2 flex items-center gap-2 text-lg"><Icon name="calendar" />{durationLabel(t)}</p>
      </div>
    </div>

    <div class="mx-auto grid max-w-7xl gap-10 px-4 py-10 lg:grid-cols-[1fr_360px]">
      <div class="space-y-10">
        {t.description ? <div class="max-w-none whitespace-pre-line text-lg text-slate-700">{t.description}</div> :
          <p class="text-lg text-slate-700">{description}</p>}

        {t.places.length > 0 && (
          <section>
            <h2 class="text-2xl font-bold">Places you'll see</h2>
            <ul class="mt-4 grid gap-3 sm:grid-cols-2">
              {t.places.map((p) => <li class="flex items-center gap-2 rounded-xl bg-slate-50 px-4 py-3"><Icon name="pin" class="h-4 w-4 text-brand" />{p}</li>)}
            </ul>
          </section>
        )}

        {t.itinerary.length > 0 && (
          <section>
            <h2 class="text-2xl font-bold">Day-by-day plan</h2>
            <ol class="mt-4 space-y-4 border-l-2 border-brand/30 pl-6">
              {t.itinerary.map((d) => (
                <li class="relative">
                  <span class="absolute -left-[33px] top-0.5 grid h-4 w-4 place-items-center rounded-full bg-brand ring-4 ring-white"></span>
                  <p class="text-sm font-semibold text-brand">Day {d.day}</p>
                  <h3 class="font-semibold">{d.title}</h3>
                  {d.details && <p class="mt-1 text-slate-600">{d.details}</p>}
                </li>
              ))}
            </ol>
          </section>
        )}

        {(t.inclusions.length > 0 || t.exclusions.length > 0) && (
          <section class="grid gap-6 sm:grid-cols-2">
            {t.inclusions.length > 0 && (
              <div>
                <h2 class="text-xl font-bold">Included</h2>
                <ul class="mt-3 space-y-2">{t.inclusions.map((x) => <li class="flex gap-2"><Icon name="check" class="mt-0.5 h-5 w-5 text-brand" />{x}</li>)}</ul>
              </div>
            )}
            {t.exclusions.length > 0 && (
              <div>
                <h2 class="text-xl font-bold">Not included</h2>
                <ul class="mt-3 space-y-2">{t.exclusions.map((x) => <li class="flex gap-2"><Icon name="x" class="mt-0.5 h-5 w-5 text-red-600" />{x}</li>)}</ul>
              </div>
            )}
          </section>
        )}

        {destination && (
          <p class="text-slate-600">More about the area: <a href={`/destinations/${destination.slug}`} class="font-semibold text-brand hover:underline">{destination.name}</a></p>
        )}
      </div>

      <aside class="lg:sticky lg:top-24 lg:self-start">
        <div class="rounded-2xl bg-white p-6 shadow-[0_10px_30px_rgba(0,0,0,.08)] ring-1 ring-black/5">
          {t.starting_price != null ? (
            <p><span class="block text-sm text-slate-500">Starting from</span><span class="text-3xl font-bold text-brand">{formatInr(t.starting_price)}</span> <span class="text-slate-500">/ traveller</span></p>
          ) : (
            <p class="text-xl font-bold">Price on request</p>
          )}
          <dl class="mt-5 space-y-3 text-sm">
            <div class="flex justify-between gap-4"><dt class="text-slate-500">Duration</dt><dd class="font-medium">{durationLabel(t)}</dd></div>
            {t.best_time && <div class="flex justify-between gap-4"><dt class="text-slate-500">Best time</dt><dd class="font-medium">{t.best_time}</dd></div>}
            {t.group_size && <div class="flex justify-between gap-4"><dt class="text-slate-500">Group size</dt><dd class="font-medium">{t.group_size}</dd></div>}
            <div class="flex justify-between gap-4"><dt class="text-slate-500">Transport</dt><dd class="font-medium">Private cab + driver</dd></div>
          </dl>
          <a href={`/book?tour=${t.slug}`} class="mt-6 block rounded-full bg-brand px-6 py-3 text-center font-semibold text-white hover:bg-brand-dark">Book this tour</a>
          {settings.phone && <a href={`tel:${settings.phone}`} class="mt-3 block rounded-full border border-slate-300 px-6 py-3 text-center font-semibold hover:bg-slate-50">Call to ask a question</a>}
          <p class="mt-4 text-center text-xs text-slate-500">No payment now. We confirm the fare with you before the trip.</p>
        </div>
      </aside>
    </div>
  </article>

  {related.length > 0 && (
    <section class="bg-slate-50 py-14">
      <div class="mx-auto max-w-7xl px-4">
        <h2 class="text-2xl font-bold">You may also like</h2>
        <div class="mt-6 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">{related.map((r) => <TourCard tour={r} />)}</div>
      </div>
    </section>
  )}
</Base>
