---
import Base from '@/layouts/Base.astro';
import PageHeader from '@/components/PageHeader.astro';
import TourCard from '@/components/TourCard.astro';
import { getCatalogue } from '@/lib/catalogue';
import { breadcrumbLd } from '@/lib/seo';

const { tours } = await getCatalogue();
const crumbs = [{ href: '/tours', label: 'Tour packages' }];
---
<Base
  title="Himachal tour packages"
  description={`${tours.length} Himachal tour packages with a private cab and driver: Shimla, Spiti, Dharamshala, Kasol, Dalhousie, Kinnaur and more.`}
  jsonLd={[breadcrumbLd(Astro.site, crumbs)]}
>
  <PageHeader eyebrow="Tour packages" title="Himachal tour packages" intro="Every tour includes a private cab with an experienced driver. Choose a tour to see the places covered and send a booking request." crumbs={crumbs} />
  <div class="mx-auto grid max-w-7xl gap-6 px-4 pb-16 sm:grid-cols-2 lg:grid-cols-4">
    {tours.map((t, i) => <TourCard tour={t} eager={i < 4} />)}
  </div>
</Base>
