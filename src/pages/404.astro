---
import Base from '@/layouts/Base.astro';
---
<Base title="Page not found" description="This page does not exist." noindex>
  <main class="mx-auto grid min-h-screen max-w-xl place-content-center gap-4 px-4 text-center">
    <h1 class="text-3xl font-bold">Page not found</h1>
    <p class="text-stone">The page you were looking for has moved or never existed.</p>
    <a href="/" class="font-semibold text-brand underline">Go to the home page</a>
  </main>
</Base>
