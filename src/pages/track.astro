---
import Base from '@/layouts/Base.astro';
import TrackBooking from '@/components/TrackBooking';
import { getCatalogue } from '@/lib/catalogue';
const { settings } = await getCatalogue();
---
<Base title="Your booking" description="Booking status" noindex>
  <div class="mx-auto max-w-3xl px-4 py-10">
    <h1 class="mb-6 text-3xl font-bold">Your booking</h1>
    <TrackBooking client:load phone={settings.phone} />
  </div>
</Base>
