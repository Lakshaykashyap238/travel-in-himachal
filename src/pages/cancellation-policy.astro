---
import LegalPage from '@/components/LegalPage.astro';
import { getCatalogue } from '@/lib/catalogue';
const { settings: s } = await getCatalogue();
---
<LegalPage title="Cancellation policy" description={`Cancellation policy for ${s.business_name} tours and cabs.`} path="/cancellation-policy">
  {s.cancellation_policy ? (
    <div class="mt-3 whitespace-pre-line leading-relaxed">{s.cancellation_policy}</div>
  ) : (
    <>
      <p>No payment is taken on this website, so cancelling a booking request online costs nothing.</p>
      <p>To cancel or change a confirmed trip, please <a href="/contact">contact us</a> as early as possible with your booking reference. Any charges for a confirmed trip are agreed with you when the trip is confirmed.</p>
    </>
  )}
</LegalPage>
