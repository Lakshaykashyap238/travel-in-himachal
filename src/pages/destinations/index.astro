---
import CatalogueImage from '@/components/CatalogueImage.astro';
import Base from '@/layouts/Base.astro';
import PageHeader from '@/components/PageHeader.astro';
import { getCatalogue, resolveImage } from '@/lib/catalogue';
import { breadcrumbLd } from '@/lib/seo';

const { destinations } = await getCatalogue();
const crumbs = [{ href: '/destinations', label: 'Destinations' }];
---
<Base title="Destinations in Himachal Pradesh" description={`Tours and cabs to ${destinations.map((d) => d.name).join(', ')}.`} jsonLd={[breadcrumbLd(Astro.site, crumbs)]}>
  <PageHeader eyebrow="Destinations" title="Destinations in Himachal Pradesh" intro="Where we take travellers, and the places worth seeing in each." crumbs={crumbs} />
  <div class="mx-auto grid max-w-7xl gap-6 px-4 pb-16 sm:grid-cols-2 lg:grid-cols-3">
    {destinations.map((d, i) => {
      const img = resolveImage(d.image_path);
      return (
        <a href={`/destinations/${d.slug}`} class="group overflow-hidden rounded-xl bg-white ring-1 ring-black/10 hover:ring-brand">
          <div class="aspect-[16/10] overflow-hidden bg-slate-200">
            {img && <CatalogueImage src={img} alt="" widths={[400, 640]} sizes="(min-width:1024px) 33vw, (min-width:640px) 50vw, 100vw" loading={i < 3 ? 'eager' : 'lazy'} class="h-full w-full object-cover transition duration-700 group-hover:scale-105" />}
          </div>
          <div class="p-5">
            <h2 class="display text-3xl uppercase group-hover:text-brand">{d.name}</h2>
            {d.places.length > 0 && <p class="mt-2 text-sm text-stone">{d.places.slice(0, 4).join(', ')}{d.places.length > 4 && ` +${d.places.length - 4} more`}</p>}
          </div>
        </a>
      );
    })}
  </div>
</Base>
