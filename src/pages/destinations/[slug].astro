---
import { getImage } from 'astro:assets';
import DestinationHero from '@/components/DestinationHero.astro';
import Base from '@/layouts/Base.astro';
import Icon from '@/components/Icon.astro';
import TourCard from '@/components/TourCard.astro';
import { getCatalogue, resolveImage, type Destination } from '@/lib/catalogue';
import { breadcrumbLd } from '@/lib/seo';

export async function getStaticPaths() {
  const { destinations } = await getCatalogue();
  return destinations.map((destination) => ({ params: { slug: destination.slug }, props: { destination } }));
}

const { destination: d } = Astro.props as { destination: Destination };
const { tours } = await getCatalogue();
const toursHere = tours.filter((t) => t.destination_slug === d.slug);
const img = resolveImage(d.image_path);
const og = img ? await getImage({ src: img, width: 1200, format: 'jpg', inferSize: typeof img === 'string' }) : undefined;
const crumbs = [{ href: '/destinations', label: 'Destinations' }, { href: `/destinations/${d.slug}`, label: d.name }];
const description = d.summary ?? `${d.name} tour packages and cab booking. Places to see: ${d.places.slice(0, 5).join(', ')}.`;

const placeLd = {
  '@context': 'https://schema.org',
  '@type': 'TouristDestination',
  name: `${d.name}, Himachal Pradesh`,
  description,
  ...(og && { image: new URL(og.src, Astro.site).toString() }),
  includesAttraction: d.places.map((p) => ({ '@type': 'TouristAttraction', name: p })),
};
---
<Base title={`${d.name} tour packages & cab booking`} description={description} image={og?.src} jsonLd={[placeLd, breadcrumbLd(Astro.site, crumbs)]}>
  <DestinationHero name={d.name} paths={[d.image_path, ...(d.gallery ?? []), ...toursHere.map((t) => t.image_path)]} />

  <div class="mx-auto max-w-7xl space-y-12 px-4 py-10">
    {d.description && <p class="max-w-3xl whitespace-pre-line text-lg text-slate-700">{d.description}</p>}

    {d.places.length > 0 && (
      <section>
        <h2 class="text-2xl font-bold">Places to see in {d.name}</h2>
        <ul class="mt-4 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
          {d.places.map((p) => <li class="flex items-center gap-2 rounded-xl bg-mist px-4 py-3"><Icon name="pin" class="h-4 w-4 text-brand" />{p}</li>)}
        </ul>
      </section>
    )}

    <section>
      <h2 class="text-2xl font-bold">{toursHere.length ? `Tours to ${d.name}` : `Visit ${d.name} with us`}</h2>
      {toursHere.length > 0 ? (
        <div class="mt-6 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">{toursHere.map((t) => <TourCard tour={t} />)}</div>
      ) : (
        <p class="mt-3 text-stone">Book a private cab to {d.name} and plan the stops with your driver.</p>
      )}
      <a href="/book?type=cab" class="mt-6 inline-block rounded-md bg-brand px-6 py-3 font-semibold text-white hover:bg-brand-dark">Book a cab to {d.name}</a>
    </section>
  </div>
</Base>
