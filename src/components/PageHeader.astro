---
interface Props { eyebrow?: string; title: string; intro?: string; crumbs?: { href: string; label: string }[] }
const { title, intro } = Astro.props;
---
<section class="border-b border-black/5 bg-mist">
  <div class="mx-auto max-w-7xl px-4 pb-10 pt-10 sm:pt-14">
    <h1 class="display text-3xl uppercase text-ink sm:text-[2.75rem]">{title}</h1>
    {intro && <p class="mt-4 max-w-2xl text-lg text-stone">{intro}</p>}
  </div>
</section>
