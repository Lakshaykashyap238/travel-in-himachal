---
interface Props { eyebrow?: string; title: string; intro?: string; crumbs?: { href: string; label: string }[] }
const { eyebrow, title, intro, crumbs = [] } = Astro.props;
---
<section class="border-b border-black/5 bg-mist">
  <div class="mx-auto max-w-7xl px-4 pb-10 pt-10">
    {crumbs.length > 0 && (
      <nav aria-label="Breadcrumb" class="mb-4 text-sm text-slate-500">
        <ol class="flex flex-wrap items-center gap-1.5">
          <li><a href="/" class="hover:text-ink">Home</a></li>
          {crumbs.map((c, i) => (
            <li class="flex items-center gap-1.5"><span aria-hidden="true">/</span>
              {i === crumbs.length - 1 ? <span aria-current="page" class="text-slate-700">{c.label}</span> : <a href={c.href} class="hover:text-ink">{c.label}</a>}
            </li>
          ))}
        </ol>
      </nav>
    )}
        <h1 class="display mt-1 text-4xl uppercase text-ink sm:text-6xl">{title}</h1>
    {intro && <p class="mt-4 max-w-2xl text-lg text-stone">{intro}</p>}
  </div>
</section>
