---
// Thumb-reach navigation for phones: the main sections are always one tap away.
import Icon from './Icon.astro';
interface Props { phone: string | null }
const { phone } = Astro.props;
const path = Astro.url.pathname.replace(/\.html$/, '');
const items = [
  { href: '/', label: 'Home', icon: 'home' },
  { href: '/tours', label: 'Tours', icon: 'mountain' },
  { href: '/destinations', label: 'Places', icon: 'pin' },
  { href: '/fleet', label: 'Cabs', icon: 'car' },
] as const;
const active = (href: string) => (href === '/' ? path === '/' : path === href || path.startsWith(`${href}/`));
---
<nav class="fixed inset-x-0 bottom-0 z-40 border-t border-black/10 bg-white/95 pb-[env(safe-area-inset-bottom)] backdrop-blur lg:hidden" aria-label="Quick">
  <ul class="grid grid-cols-5">
    {items.map((i) => (
      <li>
        <a href={i.href} aria-current={active(i.href) ? 'page' : undefined}
          class:list={['flex flex-col items-center gap-0.5 py-2 text-xs font-medium', active(i.href) ? 'text-brand' : 'text-stone']}>
          <Icon name={i.icon} class="h-6 w-6" />{i.label}
        </a>
      </li>
    ))}
    <li>
      <a href={phone ? `tel:${phone}` : '/contact'} class="flex flex-col items-center gap-0.5 py-2 text-xs font-semibold text-brand">
        <Icon name="phone" class="h-6 w-6" />{phone ? 'Call' : 'Contact'}
      </a>
    </li>
  </ul>
</nav>
