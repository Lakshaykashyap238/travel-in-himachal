---
// Hero slider rebuilt to match the original site exactly: slides move sideways
// (0.8 s ease), dark overlay, marigold tag, bold white headline, outlined EXPLORE
// pill, square arrow buttons, dots, auto-advance every 6 s.
import { getImage } from 'astro:assets';
import desk4 from '@/assets/hero/desk4.jpg';
import desk22 from '@/assets/hero/desk22.jpg';
import desk3 from '@/assets/hero/desk3.jpg';
import desk16 from '@/assets/hero/desk16.jpg';
import slide3 from '@/assets/hero/slide3.jpg';
import slide1 from '@/assets/hero/slide1.jpg';
import slide2 from '@/assets/hero/slide2.jpg';
import slide4 from '@/assets/hero/slide4.jpg';

// Copy from the original site (spelling fixed).
const slides = [
  { desk: desk4, mobile: slide3, tag: 'Welcome to Himachal', title: 'Journey Through The Woods', desc: '' },
  { desk: desk22, mobile: slide1, tag: 'Himalayan Escape', title: 'Into The Frozen Himalayas', desc: 'Discover breathtaking glaciers, snow-covered peaks and the untouched beauty of the Himalayas.' },
  { desk: desk3, mobile: slide2, tag: 'Explore The Hills', title: 'Where Nature Comes Alive', desc: 'Wander through peaceful valleys, pine forests and breathtaking mountain landscapes.' },
  { desk: desk16, mobile: slide4, tag: 'Chase The Horizon', title: 'Adventure Beyond the Ordinary', desc: 'Follow the mountain trails and experience unforgettable views beneath the Himalayan sky.' },
];

const rendered = await Promise.all(
  slides.map(async (s) => ({
    ...s,
    deskImg: await getImage({ src: s.desk, widths: [1280, 1920, 2560], sizes: '100vw', format: 'webp', quality: 72 }),
    mobImg: await getImage({ src: s.mobile, widths: [480, 800, 1080], sizes: '100vw', format: 'webp', quality: 72 }),
  })),
);
---
<section class="slider" aria-roledescription="carousel" aria-label="Highlights" data-slider>
  <button type="button" class="btn prev" aria-label="Previous slide" data-prev>&#10094;</button>

  <div class="slides" data-slides>
    {rendered.map((s, i) => (
      <div class="slide" role="group" aria-roledescription="slide" aria-label={`${i + 1} of ${rendered.length}`} aria-hidden={i === 0 ? 'false' : 'true'} data-slide>
        <picture>
          <source media="(min-width: 768px)" srcset={s.deskImg.srcSet.attribute} sizes="100vw" type="image/webp" />
          <img
            src={s.mobImg.src}
            srcset={s.mobImg.srcSet.attribute}
            sizes="100vw"
            alt=""
            loading="eager"
            fetchpriority={i === 0 ? 'high' : 'low'}
            decoding="async"
          />
        </picture>
        <div class="overlay"></div>
        <div class="slide-content">
          <p class="tag">{s.tag}</p>
          {i === 0 ? <h1>{s.title}</h1> : <p class="h1">{s.title}</p>}
          {s.desc && <p class="desc">{s.desc}</p>}
          <div class="hero-btns">
            <a href="#marqueeNav" class="explore" data-explore tabindex={i === 0 ? 0 : -1}>EXPLORE</a>
          </div>
        </div>
      </div>
    ))}
  </div>

  <button type="button" class="btn next" aria-label="Next slide" data-next>&#10095;</button>

  <div class="dots">
    {rendered.map((_, i) => (
      <button type="button" class:list={['dot', { active: i === 0 }]} aria-label={`Show slide ${i + 1}`} aria-current={i === 0 ? 'true' : 'false'} data-dot={i}></button>
    ))}
  </div>
</section>

<style>
  .slider { width: 100%; height: 420px; overflow: hidden; position: relative; background: #111; font-family: system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif; }
  .slides { display: flex; width: 100%; height: 100%; transition: transform 0.8s ease; }
  .slide { min-width: 100%; height: 100%; position: relative; flex-shrink: 0; }
  .slide picture, .slide img { display: block; width: 100%; height: 100%; }
  .slide img { object-fit: cover; }
  .overlay { position: absolute; inset: 0; background: rgba(0, 0, 0, 0.35); }

  .slide-content { position: absolute; left: 8%; bottom: 18%; z-index: 5; width: 90%; max-width: 40rem; color: #fff; }
  .slide-content .tag { margin: 0 0 0.875rem; font-size: clamp(0.8rem, 1.2vw, 1.1rem); font-weight: 800; letter-spacing: 0.1em; line-height: 1.2; text-transform: uppercase; color: #ffb52e; }
  .slide-content h1, .slide-content .h1 {
    margin: 0 0 0.75rem; padding: 0; white-space: nowrap;
    font-family: inherit; font-stretch: normal; letter-spacing: normal;
    font-size: clamp(2rem, 4vw, 3.25rem); line-height: 1.08; font-weight: 800; color: #fff;
  }
  .slide-content .desc { margin: 0 0 1.5rem; padding: 0; max-width: 35rem; font-size: clamp(0.85rem, 1.2vw, 1rem); line-height: 1.5; font-weight: 400; color: #fff; }
  .hero-btns { display: flex; align-items: center; justify-content: flex-start; }
  .explore {
    width: 10rem; min-height: 2.9rem; display: flex; align-items: center; justify-content: center;
    padding: 0.7rem 1.5rem; margin: 0; border: 0.125rem solid #fff; border-radius: 2rem; box-sizing: border-box;
    color: #fff; text-decoration: none; font-size: 0.875rem; font-weight: 700; letter-spacing: 0.02em; transition: 0.3s ease;
  }
  .explore:hover { background: #fff; color: #333; transform: translateY(-0.2rem); }

  .btn {
    position: absolute; top: 50%; transform: translateY(-50%); z-index: 6;
    width: 45px; height: 45px; border: none; border-radius: 0.2rem;
    background: rgba(0, 0, 0, 0.45); color: #fff; font-size: 1.25rem; line-height: 1; cursor: pointer;
  }
  .prev { left: 1.25rem; }
  .next { right: 1.25rem; }

  .dots { position: absolute; bottom: 15px; left: 50%; transform: translateX(-50%); display: flex; gap: 8px; z-index: 5; }
  .dot { width: 10px; height: 10px; padding: 0; border: 0; border-radius: 50%; background: #fff; opacity: 0.5; cursor: pointer; transition: transform 0.3s, opacity 0.3s; }
  .dot.active { opacity: 1; transform: scale(1.2); }

  /* Tablet */
  @media (min-width: 768px) and (max-width: 1023px) {
    .slider { height: clamp(380px, 42vw, 420px); }
    .slide-content { left: 6%; bottom: 15%; width: 70%; max-width: 650px; }
    .slide-content .tag { font-size: clamp(12px, 1.4vw, 17px); }
    .slide-content h1, .slide-content .h1 { font-size: clamp(30px, 4vw, 48px); white-space: normal; }
    .slide-content .desc { max-width: 550px; font-size: clamp(13px, 1.4vw, 16px); }
    .explore { width: clamp(145px, 17vw, 160px); min-height: 45px; font-size: 14px; }
    .btn { width: clamp(38px, 5vw, 45px); height: clamp(38px, 5vw, 45px); font-size: clamp(18px, 2.5vw, 22px); border-radius: 0; }
    .prev { left: 15px; }
    .next { right: 15px; }
  }

  /* Phone */
  @media (max-width: 767px) {
    .slide-content { left: 50%; transform: translateX(-50%); bottom: 18%; width: auto; max-width: 220px; }
    .slide-content .tag, .slide-content h1, .slide-content .h1 { text-align: center; }
    .slide-content h1, .slide-content .h1 { white-space: normal; }
    .slide-content .desc { display: none; }
    .hero-btns { justify-content: center; margin-bottom: -20px; }
    .explore { margin-top: 25px; }
  }

  @media (prefers-reduced-motion: reduce) { .slides { transition: none; } }
</style>

<script>
  const root = document.querySelector<HTMLElement>('[data-slider]');
  if (root) {
    const track = root.querySelector<HTMLElement>('[data-slides]')!;
    const slides = [...root.querySelectorAll<HTMLElement>('[data-slide]')];
    const dots = [...root.querySelectorAll<HTMLButtonElement>('[data-dot]')];
    const total = slides.length;
    let index = 0;
    let timer: number | undefined;

    const goToSlide = (i: number) => {
      index = i >= total ? 0 : i < 0 ? total - 1 : i;
      track.style.transform = `translateX(-${index * 100}%)`;
      dots.forEach((d, n) => {
        d.classList.toggle('active', n === index);
        d.setAttribute('aria-current', String(n === index));
      });
      slides.forEach((s, n) => {
        s.setAttribute('aria-hidden', String(n !== index));
        s.querySelector<HTMLElement>('[data-explore]')?.setAttribute('tabindex', n === index ? '0' : '-1');
      });
    };
    const restart = () => {
      window.clearInterval(timer);
      timer = window.setInterval(() => goToSlide(index + 1), 6000);
    };

    root.querySelector('[data-next]')!.addEventListener('click', () => { goToSlide(index + 1); restart(); });
    root.querySelector('[data-prev]')!.addEventListener('click', () => { goToSlide(index - 1); restart(); });
    dots.forEach((d, n) => d.addEventListener('click', () => { goToSlide(n); restart(); }));

    // EXPLORE scrolls down to the services strip, below the sticky header.
    root.querySelectorAll<HTMLAnchorElement>('[data-explore]').forEach((a) =>
      a.addEventListener('click', (e) => {
        const target = document.getElementById('marqueeNav');
        if (!target) return;
        e.preventDefault();
        const header = document.querySelector('header')?.getBoundingClientRect().height ?? 0;
        window.scrollTo({ top: target.getBoundingClientRect().top + window.scrollY - header, behavior: 'smooth' });
      }),
    );

    // Swipe on phones.
    let startX = 0;
    root.addEventListener('touchstart', (e) => { startX = e.touches[0].clientX; }, { passive: true });
    root.addEventListener('touchend', (e) => {
      const dx = e.changedTouches[0].clientX - startX;
      if (Math.abs(dx) > 40) { goToSlide(index + (dx < 0 ? 1 : -1)); restart(); }
    });

    if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) restart();
  }
</script>
