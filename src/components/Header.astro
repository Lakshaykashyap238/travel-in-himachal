---
import Icon from './Icon.astro';
interface Props { businessName: string; phone: string | null }
const { businessName, phone } = Astro.props;
const path = Astro.url.pathname;
const links = [
  { href: '/tours', label: 'Tours' },
  { href: '/destinations', label: 'Destinations' },
  { href: '/fleet', label: 'Cabs' },
  { href: '/about', label: 'About' },
  { href: '/contact', label: 'Contact' },
];
const active = (href: string) => path === href || path.startsWith(`${href}/`);
---
<header class="sticky top-0 z-40 border-b border-black/5 bg-[#f6f3f3]/95 backdrop-blur">
  <nav class="mx-auto flex h-16 max-w-7xl items-center justify-between gap-4 px-4" aria-label="Main">
    <a href="/" class="truncate text-lg font-bold tracking-tight text-brand sm:text-2xl">{businessName}</a>

    <ul class="hidden items-center gap-7 lg:flex">
      {links.map((l) => (
        <li>
          <a
            href={l.href}
            class:list={['relative py-1 font-medium text-slate-700 hover:text-ink', active(l.href) && 'text-ink after:absolute after:inset-x-0 after:-bottom-0.5 after:h-0.5 after:bg-ink']}
            aria-current={active(l.href) ? 'page' : undefined}
          >{l.label}</a>
        </li>
      ))}
    </ul>

    <div class="flex shrink-0 items-center gap-2">
      {phone && (
        <a href={`tel:${phone}`} class="hidden items-center gap-2 rounded-full px-3 py-2 text-sm font-semibold text-slate-700 hover:bg-black/5 md:flex">
          <Icon name="phone" class="h-4 w-4" /> Call us
        </a>
      )}
      <a href="/book" class="whitespace-nowrap rounded-full bg-brand px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-brand-dark">Book now</a>
      <button
        type="button"
        class="rounded-lg p-2 text-slate-700 hover:bg-black/5 lg:hidden"
        aria-controls="mobile-menu"
        aria-expanded="false"
        data-menu-toggle
      >
        <span class="sr-only">Open menu</span>
        <Icon name="menu" class="h-6 w-6" />
      </button>
    </div>
  </nav>

  <div id="mobile-menu" class="hidden border-t border-black/5 bg-white lg:hidden" data-menu>
    <ul class="mx-auto max-w-7xl px-4 py-2">
      {links.map((l) => (
        <li><a href={l.href} class="block rounded-lg px-3 py-3 font-medium text-slate-800 hover:bg-slate-50" aria-current={active(l.href) ? 'page' : undefined}>{l.label}</a></li>
      ))}
      {phone && <li><a href={`tel:${phone}`} class="block rounded-lg px-3 py-3 font-medium text-brand">Call {phone}</a></li>}
    </ul>
  </div>
</header>

<script>
  const btn = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const menu = document.querySelector<HTMLElement>('[data-menu]');
  btn?.addEventListener('click', () => {
    const open = btn.getAttribute('aria-expanded') === 'true';
    btn.setAttribute('aria-expanded', String(!open));
    menu?.classList.toggle('hidden', open);
  });
</script>
