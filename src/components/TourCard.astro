---
import CatalogueImage from '@/components/CatalogueImage.astro';
import { durationLabel, formatInr, resolveImage, type Tour } from '@/lib/catalogue';
interface Props { tour: Tour; eager?: boolean }
const { tour: t, eager = false } = Astro.props;
const img = resolveImage(t.image_path);
---
<article class="group relative flex flex-col">
  <a href={`/tours/${t.slug}`} class="relative block aspect-[4/5] overflow-hidden rounded-xl bg-night">
    {img && (
      <CatalogueImage
        src={img}
        alt=""
        widths={[360, 540, 720]}
        sizes="(min-width: 1024px) 25vw, (min-width: 640px) 50vw, 100vw"
        loading={eager ? 'eager' : 'lazy'}
        class="h-full w-full object-cover transition duration-700 group-hover:scale-[1.03] motion-reduce:transition-none"
      />
    )}
    <span class="absolute inset-0 bg-gradient-to-t from-night via-night/40 to-transparent"></span>
    <span class="absolute right-3 top-3 rounded-md bg-white/95 px-2.5 py-1 text-sm font-semibold text-ink">{durationLabel(t)}</span>
    <span class="absolute inset-x-0 bottom-0 p-4 text-white">
      <span class="display block text-[1.75rem] uppercase">{t.name}</span>
      {t.best_time && <span class="mt-1 block text-sm text-white/80">Best from {t.best_time}</span>}
    </span>
  </a>
  <div class="flex items-center justify-between gap-3 px-1 pt-3">
    {t.starting_price != null ? (
      <p class="leading-tight"><span class="text-xl font-semibold text-ink">{formatInr(t.starting_price)}</span><span class="text-sm text-stone"> per person</span></p>
    ) : (
      <p class="text-sm text-stone">Price on request</p>
    )}
    <a href={`/book?tour=${t.slug}`} class="shrink-0 rounded-md bg-brand px-4 py-2 text-sm font-semibold text-white hover:bg-brand-dark" aria-label={`Book ${t.name}`}>Book</a>
  </div>
</article>
